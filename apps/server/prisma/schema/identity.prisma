// Identity: who uses the service and how they log in (spec 02 §7).
// PRIVACY: learner rows carry no name or e-mail; a CHECK constraint in the first migration enforces it (DATA-002).

/// Staff (authors, admins) or learner.
enum UserKind {
  staff
  learner
}

/// Where an identity comes from.
enum IdentityProvider {
  feide
  lti
}

/// A person who uses the service. Only staff rows may hold a display name and e-mail.
model User {
  id                   String    @id @default(uuid(7)) @db.Uuid
  kind                 UserKind
  displayName          String?
  email                String?
  createdAt            DateTime  @default(now())
  /// PRIVACY: set at each Feide login of an HVL member with an `employee`, `faculty` or `staff` affiliation and
  /// cleared at a Feide login without one (D-090). Colleagues can find the person as a co-author only while it is
  /// set and less than 13 months old. Never set for learners, student authors or LTI-only accounts.
  coAuthorSearchableAt DateTime?

  identities       Identity[]
  ownedContent     H5PContent[]                @relation("ContentOwner")
  attributedCopies H5PContent[]                @relation("ContentSourceAuthor")
  collaborations   ContentCollaborator[]
  acknowledgements ValidationAcknowledgement[]
  noticeDismissals NoticeDismissal[]

  // WHY: co-author search filters on a recent `coAuthorSearchableAt` before it matches names (D-090).
  @@index([coAuthorSearchableAt])
}

/// One way a user logs in. `subjectHash` is an HMAC of the Feide ID or of `iss|sub`, never the raw value, made
/// with the `IDENTITY_HASH_KEYS` key named in `subjectKeyId` (D-055: re-hashed with the current key at login).
model Identity {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @db.Uuid
  provider     IdentityProvider
  subjectHash  String
  subjectKeyId String
  platformId   String?          @db.Uuid
  createdAt    DateTime         @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform LtiPlatform? @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([provider, subjectHash])
  @@index([userId])
}

/// Login, logout, launch and account-linking events (D-064). No foreign key, so the record outlives the user
/// row. `ipHash` is made with the `IDENTITY_HASH_KEYS` key named in `ipKeyId`; `reason` is a fixed code.
model AuthAuditEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  at          DateTime @default(now())
  actorUserId String?  @db.Uuid
  event       String
  reason      String?
  ipHash      String?
  ipKeyId     String?

  @@index([at])
  @@index([actorUserId])
}

/// A notice a staff user dismissed, e.g. the formative-use notice (PROD-011, D-075). One row per user and notice;
/// a newer `noticeVersion` replaces it, and a notice whose current version is higher is shown again.
model NoticeDismissal {
  userId        String   @db.Uuid
  noticeId      String
  noticeVersion Int
  at            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, noticeId])
}
