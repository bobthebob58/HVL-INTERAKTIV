// LTI 1.3: platforms and the short-lived records ltijs 7 needs (DatabaseManager), placements in Canvas,
// and the grade passback queue (spec 02 §7). Secrets are stored encrypted by the application.

/// How an activity's score is sent to the Canvas gradebook (LTI-012).
enum AttemptPolicy {
  best
  latest
  mastery
}

/// State of one grade passback (LTI-012, D-104). Only `pending` is worked on; an author's retry makes a `failed` job
/// pending again, while `succeeded` and `orphaned` are final.
enum GradeSyncStatus {
  pending
  succeeded
  failed
  /// The line item is gone (404, confirmed with a `lineitem.readonly` read); never retried (D-104).
  orphaned
}

/// A registered LMS (e.g. HVL's Canvas). `url` is the issuer; the tool's private key is encrypted.
model LtiPlatform {
  id                      String   @id @default(uuid(7)) @db.Uuid
  url                     String
  clientId                String
  name                    String
  authenticationEndpoint  String
  accessTokenEndpoint     String
  authorizationServer     String?
  idTokenValidationMethod String
  idTokenValidationKey    String
  active                  Boolean  @default(true)
  publicKey               String
  privateKeyEncrypted     Bytes
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  identities  Identity[]
  placements  LtiPlacement[]
  deployments LtiDeployment[]

  @@unique([url, clientId])
}

/// A deployment of the tool on a platform that may launch it (D-051). Replaced from `LTI_PLATFORMS` at start-up;
/// a launch whose `deployment_id` is not listed gets no ltik.
model LtiDeployment {
  id           String   @id @default(uuid(7)) @db.Uuid
  platformId   String   @db.Uuid
  deploymentId String
  createdAt    DateTime @default(now())

  platform LtiPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([platformId, deploymentId])
}

/// A cached OAuth2 access token from a platform (client-credentials grant), encrypted.
model LtiAccessToken {
  id             String   @id @default(uuid(7)) @db.Uuid
  platformUrl    String
  clientId       String
  scopes         String
  tokenEncrypted Bytes
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([platformUrl, clientId, scopes])
}

/// A validated LTI launch id_token. PRIVACY: only allowlisted claims are stored (D-052), never names, e-mail,
/// `lis` or unknown custom fields; never read after 24 h and deleted by the next cleanup run (D-052).
model LtiIdToken {
  id        String   @id
  claims    Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

/// A used OIDC nonce, kept 10 minutes to reject replays (D-052).
model LtiNonce {
  nonce     String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// An activity placed in a Canvas course through Deep Linking.
model LtiPlacement {
  id               String        @id @default(uuid(7)) @db.Uuid
  platformId       String        @db.Uuid
  contextId        String
  resourceLinkId   String
  contentId        String        @db.Uuid
  lineItemUrl      String?
  attemptPolicy    AttemptPolicy @default(best)
  masteryThreshold Float?
  /// The platform's course label from the launch's `context.label` (e.g. `SYK110`), suggested as a course code
  /// to the author (D-087). Kept only when it looks like a course code with a digit; a sandbox label such as
  /// «Kari 2025» can still pass, an accepted residual (D-087 amendment, data inventory).
  contextLabel     String?       @db.VarChar(255)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  platform      LtiPlatform    @relation(fields: [platformId], references: [id], onDelete: Cascade)
  content       H5PContent     @relation(fields: [contentId], references: [id], onDelete: Cascade)
  gradeSyncJobs GradeSyncJob[]

  @@unique([platformId, contextId, resourceLinkId])
  @@index([contentId])
}

/// One formative score for one attempt, waiting to be sent to Canvas (AGS, LTI-012, D-104). The worker coalesces a
/// learner's due jobs per placement, sends one score by the placement's attempt policy and settles them together.
/// PRIVACY: `ltiSubEncrypted` is the only raw learner ID kept longer than 24 hours (LtiIdToken.claims holds `sub` for
/// 24 h); it is set to null 30 days after `terminalAt`, whatever the outcome (DATA-002 as amended, D-104).
model GradeSyncJob {
  id              String          @id @default(uuid(7)) @db.Uuid
  placementId     String          @db.Uuid
  learnerKey      String
  ltiSubEncrypted Bytes?
  /// The bridge's attempt, `<viewId>:<n>`, whose gradable root result made the job (D-115).
  attemptId       String
  /// That result's `scaled × 100` (D-115); the attempt policy chooses among a learner's job scores (D-104).
  scoreGiven      Float
  /// When the server stored that result (its statement's `timestamp`, D-115); orders the attempts for `latest`.
  resultAt        DateTime
  status          GradeSyncStatus @default(pending)
  attempts        Int             @default(0)
  lastError       String?
  /// `<placementId>:<learnerKey>:<attemptId>`: one job per placement, learner and attempt (D-104); a repeated
  /// result of the same attempt updates its job.
  idempotencyKey  String          @unique
  /// When the worker may next try; null once the job is no longer `pending` (D-104).
  nextAttemptAt   DateTime?       @default(now())
  succeededAt     DateTime?
  /// When the job stopped (succeeded, failed or orphaned); `ltiSubEncrypted` is cleared 30 days later (D-104).
  terminalAt      DateTime?
  /// The academic year of the pseudonym secret that made `learnerKey`; the yearly purge deletes by it (D-107). A job
  /// comes from a Canvas request, which derives its key when it is made, so the database default (the year of the
  /// write in Oslo) is that key's year; the enqueuer may still set it explicitly.
  academicYear    Int             @default(dbgenerated("(EXTRACT(year FROM ((now() AT TIME ZONE 'Europe/Oslo'::text) - '7 mons'::interval)))::integer"))
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  placement LtiPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  // WHY: the worker claims due jobs by status and time (`FOR UPDATE SKIP LOCKED`, D-104).
  @@index([status, nextAttemptAt])
  // WHY: coalescing and the attempt policy read one learner's jobs in one placement (D-104).
  @@index([placementId, learnerKey])
  // WHY: the authors' status counts are per placement and status (LTI-012).
  @@index([placementId, status])
  @@index([terminalAt])
  @@index([learnerKey])
  @@index([academicYear])
}
