// Content: H5P activities, their files, co-authors, learner resume state and library changes (spec 01 §6).

/// Draft activities are visible to their authors only.
enum ContentStatus {
  draft
  published
}

/// Who may open an activity outside Canvas (PROD-006): owner and co-authors, the organisation, any Feide user.
enum ContentVisibility {
  private
  organisation
  feide
}

/// Role of a co-author on an activity.
enum CollaboratorRole {
  coauthor
}

/// One H5P activity. `params` and `metadata` are H5P's own JSON (content.json and h5p.json).
model H5PContent {
  id                 String            @id @default(uuid(7)) @db.Uuid
  mainLibrary        String
  title              String
  params             Json
  metadata           Json
  status             ContentStatus     @default(draft)
  visibility         ContentVisibility @default(private)
  ownerUserId        String            @db.Uuid
  version            Int               @default(1)
  sourceContentId    String?           @db.Uuid
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  /// When the activity was last published through the publish flow (PROD-003); null while it is a draft.
  publishedAt        DateTime?
  /// When the owner listed the activity in the HVL content bank (PROD-007, D-091); null when it is not listed.
  /// Making the activity private or unpublishing it clears it in the same transaction.
  bankListedAt       DateTime?
  /// The owner of `sourceContentId` when this copy was made (PROD-007, D-092), for attribution; the name is read
  /// when the copy is shown. Null for an original, and set to null when that account is deleted.
  sourceAuthorUserId String?           @db.Uuid

  owner            User                        @relation("ContentOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  sourceAuthor     User?                       @relation("ContentSourceAuthor", fields: [sourceAuthorUserId], references: [id], onDelete: SetNull)
  source           H5PContent?                 @relation("ContentCopies", fields: [sourceContentId], references: [id], onDelete: SetNull)
  copies           H5PContent[]                @relation("ContentCopies")
  files            H5PContentFile[]
  collaborators    ContentCollaborator[]
  userData         H5PUserData[]
  placements       LtiPlacement[]
  learningDesign   LearningDesignMetadata?
  acknowledgements ValidationAcknowledgement[]
  statements       XapiStatement[]
  snapshots        InsightSnapshot[]

  @@index([ownerUserId])
  @@index([mainLibrary])
  // WHY: the content bank page lists the bank-listed activities, newest listing first (D-091).
  @@index([bankListedAt])
}

/// A file used by an activity (image, video, audio). The bytes live in S3 under `s3Key`.
model H5PContentFile {
  id        String   @id @default(uuid(7)) @db.Uuid
  contentId String   @db.Uuid
  filename  String
  s3Key     String   @unique
  size      Int
  sha256    String
  createdAt DateTime @default(now())

  content H5PContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, filename])
}

/// A staff user who may edit an activity they do not own.
model ContentCollaborator {
  contentId String           @db.Uuid
  userId    String           @db.Uuid
  role      CollaboratorRole @default(coauthor)
  createdAt DateTime         @default(now())

  content H5PContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([contentId, userId])
  @@index([userId])
}

/// H5P resume state for one learner (pseudonym) in one activity and context (H5P-005).
model H5PUserData {
  id           String   @id @default(uuid(7)) @db.Uuid
  contentId    String   @db.Uuid
  subContentId String   @default("0")
  dataType     String
  learnerKey   String
  contextId    String   @default("")
  data         Json
  preload      Boolean  @default(false)
  invalidate   Boolean  @default(false)
  updatedAt    DateTime @updatedAt
  /// The academic year of the pseudonym secret that made `learnerKey`; the yearly purge deletes by it (D-107). The
  /// database default is the year of the write in Oslo, which a portal session's key can predate by up to 12 hours
  /// after 1 August (D-057), so the writer of a portal learner's row sets the key's year itself.
  academicYear Int      @default(dbgenerated("(EXTRACT(year FROM ((now() AT TIME ZONE 'Europe/Oslo'::text) - '7 mons'::interval)))::integer"))

  content H5PContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, subContentId, dataType, learnerKey, contextId])
  // WHY: the player preloads all of one learner's state for an activity on every page load (H5P-005).
  @@index([contentId, learnerKey, contextId])
  @@index([learnerKey])
  @@index([updatedAt])
  @@index([academicYear])
}

/// How a library change arrived (D-041): the seed command or an admin's package import.
enum LibraryChangeSource {
  seed
  upload
}

/// An H5P library was installed or updated (H5P-011, DATA-007).
model LibraryAuditEvent {
  id          String              @id @default(uuid(7)) @db.Uuid
  /// The admin who imported the package; empty when the seed command installed it (D-041).
  actorUserId String?             @db.Uuid
  source      LibraryChangeSource
  machineName String
  fromVersion String?
  toVersion   String?
  sha256      String?
  at          DateTime            @default(now())

  @@index([at])
  @@index([machineName])
}
