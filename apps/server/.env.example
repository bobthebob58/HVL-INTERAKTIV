# HVL Interaktiv server configuration (DOC-008).
# Copy to apps/server/.env for local development. The values below match docker-compose.yml.
# Every variable is validated at startup by src/config/env.ts; the server refuses to start on any error.
# "Secret: yes" values belong in the secret store in staging and production, never in git.

# Purpose: runtime mode. "production" adds startup checks (src/config/productionChecks.ts): a pseudonym secret
#   for the current academic year must exist; no pseudonym secret or ring key may be readable text (like the
#   examples below), have fewer than 16 distinct bytes, or be used in two places; and every public, Feide,
#   Canvas and LTI platform URL must use https. Other example values (e.g. FEIDE_CLIENT_SECRET) are not detected.
# Secret: no. Default: development. Allowed: development, test, production.
NODE_ENV=development

# Purpose: minimum level written to the structured log (pino). Logs never contain personal data (DATA-009).
# Secret: no. Default: info. Allowed: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info

# Purpose: PostgreSQL 16 connection string for all relational data (Prisma).
# Secret: yes (contains the password). Default: none, required.
DATABASE_URL=postgresql://hvli:hvli-dev@localhost:5432/hvli

# Purpose: Redis 7 for the shared H5P key-value cache and cluster-wide locks.
# Secret: yes when it contains a password. Default: none, required.
REDIS_URL=redis://localhost:6379

# Purpose: S3-compatible endpoint for content and temporary files. Leave empty for AWS itself.
# Secret: no. Default: empty (AWS endpoint for S3_REGION). Local: the S3 emulator from docker-compose.yml.
S3_ENDPOINT=http://localhost:5000

# Purpose: S3 region. Data must stay in Norway or the EEA (DATA-004).
# Secret: no. Default: eu-north-1.
S3_REGION=eu-north-1

# Purpose: S3 access key ID for the server's own storage user.
# Secret: yes. Default: none, required.
S3_ACCESS_KEY_ID=test

# Purpose: S3 secret access key that belongs to S3_ACCESS_KEY_ID.
# Secret: yes. Default: none, required.
S3_SECRET_ACCESS_KEY=test

# Purpose: use path-style bucket URLs (needed by most S3-compatible stores outside AWS).
# Secret: no. Default: true. Allowed: true, false.
S3_FORCE_PATH_STYLE=true

# Purpose: bucket for H5P content files (images, video, audio inside activities).
# Secret: no. Default: hvli-content.
S3_CONTENT_BUCKET=hvli-content

# Purpose: bucket for files uploaded in the editor before the author saves. Add a 1-day lifecycle rule.
# Secret: no. Default: hvli-temporary.
S3_TEMPORARY_BUCKET=hvli-temporary

# Purpose: folder with the H5P core client files (tag 1.28.0), filled by `npm run h5p:fetch-core` (D-027).
# Secret: no. Default: h5p/core (relative to apps/server).
H5P_CORE_DIR=h5p/core

# Purpose: folder with the H5P editor client files (pinned commit, D-022), filled by `npm run h5p:fetch-core`.
# Secret: no. Default: h5p/editor (relative to apps/server).
H5P_EDITOR_DIR=h5p/editor

# Purpose: folder for installed H5P libraries; one volume shared by every server instance (D-026).
# Secret: no. Default: var/h5p/libraries (relative to apps/server).
H5P_LIBRARY_DIR=var/h5p/libraries

# Purpose: this installation's H5P Hub site UUID, registered once and then kept (spec 01 §1, workaround F2).
# Secret: no. Default: empty (registered at the first Hub contact). Example: 0b3c6a9e-6d1f-4c1e-9f0a-2f6a1d2b3c4d
H5P_SITE_UUID=

# Purpose: HMAC secrets for learner pseudonyms, one per academic year (DATA-002), as YEAR=base64,…
#   YEAR is the year the academic year starts (2026 = 1 Aug 2026 to 31 Jul 2027). Each secret is at
#   least 32 random bytes: `openssl rand -base64 32`, and no two years may share one. A year's secret is
#   destroyed at its yearly purge.
# Secret: yes. Default: none, required. The example values are readable text, so production refuses them.
PSEUDONYM_SECRETS=2025=ZGV2LW9ubHktcHNldWRvbnltLXNlY3JldC0yMDI1LWRvLW5vdC11c2U=,2026=ZGV2LW9ubHktcHNldWRvbnltLXNlY3JldC0yMDI2LWRvLW5vdC11c2U=

# Purpose: the public origin of this server, as browsers, Feide and Canvas reach it (no path). Builds the Feide
#   redirect URI (<origin>/auth/feide/callback), the LTI launch, login and keyset URLs, and absolute links.
# Secret: no. Default: http://localhost:3000. Production: https, e.g. https://interaktiv.hvl.no
PUBLIC_BASE_URL=http://localhost:3000

# Purpose: TCP port the server listens on.
# Secret: no. Default: 3000.
PORT=3000

# Purpose: number of reverse proxies in front of the server whose X-Forwarded-* headers are trusted (Express
#   "trust proxy"), so the client address and https are seen correctly. 0 trusts none. Never more than the
#   proxies you run: a higher value lets a client fake its address.
# Secret: no. Default: 0. Allowed: 0-5. Typical production value: 1.
TRUST_PROXY=0

# Purpose: origins allowed to frame the LTI pages (CSP frame-ancestors, LTI-003): the institution's Canvas
#   domains, comma-separated, e.g. https://hvl.instructure.com,https://hvl.test.instructure.com. Never
#   sso.canvaslms.com (the storage frame is a sibling, not an ancestor). Local: the mock Canvas, on 127.0.0.1 so
#   that it is a different site from the tool on localhost and the iframe is third-party, as in production.
# Secret: no. Default: empty (LTI pages cannot be framed).
CANVAS_ORIGINS=http://127.0.0.1:4100

# Purpose: the LTI 1.3 platforms (Canvas developer keys) and their deployments, as a JSON array (D-051):
#   [{"name","issuer","clientId","authEndpoint","tokenEndpoint","jwksUrl","deployments":["…"]}].
#   Synced at start-up: new platforms are registered, removed ones deactivated, deployments replaced. A launch
#   from an unlisted deployment gets no ltik. Production Canvas: issuer https://canvas.instructure.com,
#   authEndpoint https://sso.canvaslms.com/api/lti/authorize_redirect, tokenEndpoint
#   https://sso.canvaslms.com/login/oauth2/token, jwksUrl https://sso.canvaslms.com/api/lti/security/jwks
#   (docs/reference/canvas-platform-values.md). Local: the mock Canvas from tools/mock-platform.
# Secret: no. Default: [] (no platform; every launch is refused).
LTI_PLATFORMS=[{"name":"Mock Canvas","issuer":"http://127.0.0.1:4100","clientId":"hvli-dev-client","authEndpoint":"http://127.0.0.1:4100/api/lti/authorize_redirect","tokenEndpoint":"http://127.0.0.1:4100/login/oauth2/token","jwksUrl":"http://127.0.0.1:4100/api/lti/security/jwks","deployments":["1:hvli-dev-deployment"]}]

# Purpose: how old (in seconds) an LTI ID token may be when it reaches the server (its iat claim); older
#   launches are refused as replays (LTI-001).
# Secret: no. Default: 10. Allowed: 1-60.
LTI_TOKEN_MAX_AGE_SECONDS=10

# Purpose: the Feide OpenID Connect issuer; discovery reads <issuer>/.well-known/openid-configuration (AUTH-001).
# Secret: no. Default: https://auth.dataporten.no. Local: the mock Feide from tools/mock-platform.
FEIDE_ISSUER=http://localhost:4200

# Purpose: this server's client ID in the Feide Customer Portal (kunde.feide.no).
# Secret: no. Default: none, required.
FEIDE_CLIENT_ID=hvli-dev-client

# Purpose: the client secret that belongs to FEIDE_CLIENT_ID. Never logged (AUTH-001).
# Secret: yes. Default: none, required.
FEIDE_CLIENT_SECRET=dev-only-feide-client-secret

# Purpose: base URL of the Feide Groups API; roles come from <url>/groups/me/groups (AUTH-002).
# Secret: no. Default: https://groups-api.dataporten.no. Local: the mock Feide's Groups API.
FEIDE_GROUPS_API_URL=http://localhost:4200

# Purpose: Feide realms whose users are HVL members (author roles by affiliation); users from other realms are
#   learners who see only activities shared with "anyone with Feide" (AUTH-002, D-059). Comma-separated.
# Secret: no. Default: hvl.no.
ALLOWED_FEIDE_ORGS=hvl.no

# Purpose: Feide IDs (eduPersonPrincipalName, e.g. name@hvl.no) that get the admin role at portal login, which
#   allows installing and updating H5P libraries. Comma-separated; an LTI launch never grants admin.
# Secret: no. Default: empty (no admins).
ADMIN_FEIDE_IDS=

# Purpose: Feide course groups (groups-edu) whose students may author, e.g. fc:fs:fs:emne:hvl.no:PPU101. An entry
#   matches a group ID exactly or as a prefix followed by ":" (AUTH-002, D-059). Comma-separated.
# Secret: no. Default: empty (students never author).
AUTHOR_COURSE_GROUPS=

# Purpose: key ring for stable identity hashes (Identity.subjectHash, AuthAuditEvent.ipHash), as id=base64,…
#   with the current key first (D-055). Each key is at least 32 random bytes: `openssl rand -base64 32`; an
#   ID is 1-32 characters of A-Z a-z 0-9 _ -. Rotate by putting a new key first; remove the old key after
#   13 months, or at once if it leaked.
# Secret: yes. Default: none, required. The example key is readable text, so production refuses it.
IDENTITY_HASH_KEYS=dev1=ZGV2LW9ubHktaWRlbnRpdHktaGFzaC1rZXktMS1kby1ub3QtdXNl

# Purpose: key ring that encrypts secrets at rest (LTI tool private keys, LTI access tokens, the session's Feide
#   ID token) with AES-256-GCM, as id=base64,… with the current key first (D-056). Keep a removed key until no
#   stored value uses it: values are re-encrypted with the current key when they are next written.
# Secret: yes. Default: none, required. The example key is readable text, so production refuses it.
DATA_ENCRYPTION_KEYS=dev1=ZGV2LW9ubHktZGF0YS1lbmNyeXB0aW9uLWtleS0xLWRvLW5vdC11c2U=

# Purpose: key ring that signs content-file URLs (valid 12 hours), as id=base64,… with the current key first
#   (D-058). Remove an old key 12 hours after a new one was put first.
# Secret: yes. Default: none, required. The example key is readable text, so production refuses it.
URL_SIGNING_KEYS=dev1=ZGV2LW9ubHktdXJsLXNpZ25pbmcta2V5LTEtZG8tbm90LXVzZQ==
