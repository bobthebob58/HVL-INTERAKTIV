  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "boot-check": "tsx --env-file-if-exists=.env src/h5p/bootCheck.ts",
    "seed:libraries": "tsx --env-file-if-exists=.env src/h5p/libraries/seedCli.ts",
    "hub:check": "tsx --env-file-if-exists=.env src/h5p/hubCheckCli.ts",
    "docs:api": "typedoc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@aws-sdk/lib-storage": "3.1155.0",
    "@fastify/busboy": "3.2.4",
    "@lumieducation/h5p-redis-lock": "10.0.4",
    "@lumieducation/h5p-server": "10.0.4",
    "@lumieducation/h5p-svg-sanitizer": "10.0.4",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cache-manager": "4.1.0",
    "dompurify": "3.4.17",
    "express": "5.3.0",
    "file-type": "22.2.0",
    "i18next": "26.5.5",
    "jsdom": "26.1.0",
    "pino": "10.4.0",
    "redis": "4.7.1",
    "sanitize-html": "2.18.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cache-manager": "4.0.6",
    "@types/express": "5.0.6",
    "@types/jsdom": "21.1.7",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "7.2.1",
    "@types/yauzl": "2.10.3",
    "@types/yazl": "3.3.0",
    "playwright-core": "1.56.1",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "yazl": "3.3.1"
  }
}
