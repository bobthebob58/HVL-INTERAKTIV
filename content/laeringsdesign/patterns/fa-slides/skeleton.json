                      }
                    }
                  ],
                  "behaviour": {
                    "enableRetry": true,
                    "enableSolutionsButton": true
                  },
                  "UI": {
                    "submitAnswerButton": "{{submitButton}}",
                    "readFeedback": "{{readFeedback}}",
                    "correctAnswer": "{{correctAnswerLabel}}",
                    "scoreBarLabel": "{{scoreBarLabel}}",
                    "a11yCheck": "{{a11yCheck}}",
                    "a11yShowSolution": "{{a11yShowSolution}}",
                    "a11yRetry": "{{a11yRetry}}"
                  },
                  "confirmCheck": {
                    "header": "{{confirmCheckHeader}}"
                  }
                },
                "metadata": {
                  "title": "{{checkTitle}}",
                  "license": "U"
                }
              }
            }
          ],
          "keywords": [
            {
              "main": "{{concept3Name}}"
            }
          ]
        },
        {
          "elements": [
            {
              "x": 5,
              "y": 5,
              "width": 90,
              "height": 40,
              "action": {
                "library": "H5P.AdvancedText 1.1",
                "params": {
                  "text": "<h2>{{concept4Name}}</h2><p>{{conceptText}}</p>"
                },
                "metadata": {
                  "title": "{{textTitle}}",
                  "license": "U"
                }
              }
            },
            {
              "x": 5,
              "y": 47,
              "width": 90,
              "height": 48,
              "action": {
                "library": "H5P.Blanks 1.14",
                "params": {
                  "text": "<p>{{blanksTask}}</p>",
                  "questions": ["<p>{{blanksSentence}} *{{blanksAnswer}}*</p>"],
                  "behaviour": {
                    "enableRetry": true,
                    "enableSolutionsButton": true,
                    "caseSensitive": false,
