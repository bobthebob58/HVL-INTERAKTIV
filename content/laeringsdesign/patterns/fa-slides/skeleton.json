        },
        {
          "elements": [
            {
              "x": 5,
              "y": 10,
              "width": 90,
              "height": 80,
              "action": {
                "library": "H5P.AdvancedText 1.1",
                "params": {
                  "text": "<h2>{{summaryName}}</h2><p>{{summaryText}}</p>"
                },
                "metadata": {
                  "title": "{{textTitle}}",
                  "license": "U"
                }
              }
            }
          ],
          "keywords": [
            {
              "main": "{{summaryName}}"
            }
          ]
        }
      ],
      "keywordListEnabled": true
    },
    "override": {
      "activeSurface": false,
      "hideSummarySlide": false,
      "showSolutionButton": "on",
      "retryButton": "on",
      "summarySlideSolutionButton": true,
      "summarySlideRetryButton": true
    },
    "l10n": {
      "slides": "{{cpSlides}}",
      "resultHeader": "{{cpResults}}",
      "amountCorrect": "{{cpAmountCorrect}}",
      "amountCorrectAria": "{{cpAmountCorrectAria}}",
      "confirmDialogConfirmLabel": "{{cpConfirm}}",
      "confirmDialogCancelLabel": "{{cpCancel}}"
