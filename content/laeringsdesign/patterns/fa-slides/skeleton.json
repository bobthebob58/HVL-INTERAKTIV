{
  "library": "H5P.CoursePresentation 1.28",
  "metadataTitle": "{{title}}",
  "params": {
    "presentation": {
      "slides": [
        {
          "elements": [
            {
              "x": 5,
              "y": 10,
              "width": 90,
              "height": 80,
              "action": {
                "library": "H5P.AdvancedText 1.1",
                "params": {
                  "text": "<h2>{{presentationHeading}}</h2><p>{{presentationIntro}}</p>"
                },
                "metadata": {
                  "title": "{{textTitle}}",
                  "license": "U"
                }
              }
            }
          ],
          "keywords": [
            {
              "main": "{{introName}}"
            }
          ]
        },
        {
          "elements": [
            {
              "x": 5,
              "y": 5,
              "width": 90,
              "height": 40,
              "action": {
                "library": "H5P.AdvancedText 1.1",
                "params": {
                  "text": "<h2>{{concept1Name}}</h2><p>{{conceptText}}</p>"
                },
                "metadata": {
                  "title": "{{textTitle}}",
                  "license": "U"
                }
              }
            },
            {
              "x": 5,
              "y": 47,
              "width": 90,
              "height": 48,
              "action": {
                "library": "H5P.MultiChoice 1.16",
                "params": {
                  "question": "<p>{{checkQuestion}}</p>",
                  "answers": [
                    {
                      "text": "<div>{{correctAnswer}}</div>",
                      "correct": true,
                      "tipsAndFeedback": {
                        "chosenFeedback": "<div>{{correctFeedback}}</div>"
                      }
                    },
                    {
                      "text": "<div>{{wrongAnswer1}}</div>",
                      "correct": false,
                      "tipsAndFeedback": {
                        "chosenFeedback": "<div>{{wrongFeedback}}</div>"
                      }
                    },
                    {
                      "text": "<div>{{wrongAnswer2}}</div>",
                      "correct": false,
                      "tipsAndFeedback": {
                        "chosenFeedback": "<div>{{wrongFeedback}}</div>"
                      }
                    }
                  ],
                  "behaviour": {
                    "enableRetry": true,
                    "enableSolutionsButton": true
                  },
                  "UI": {
                    "submitAnswerButton": "{{submitButton}}",
                    "readFeedback": "{{readFeedback}}",
                    "correctAnswer": "{{correctAnswerLabel}}",
                    "scoreBarLabel": "{{scoreBarLabel}}",
                    "a11yCheck": "{{a11yCheck}}",
                    "a11yShowSolution": "{{a11yShowSolution}}",
                    "a11yRetry": "{{a11yRetry}}"
                  },
                  "confirmCheck": {
                    "header": "{{confirmCheckHeader}}"
                  }
                },
                "metadata": {
                  "title": "{{checkTitle}}",
                  "license": "U"
                }
              }
            }
          ],
          "keywords": [
            {
              "main": "{{concept1Name}}"
            }
          ]
        },
        {
          "elements": [
            {
              "x": 5,
              "y": 5,
              "width": 90,
              "height": 40,
              "action": {
                "library": "H5P.AdvancedText 1.1",
                "params": {
                  "text": "<h2>{{concept2Name}}</h2><p>{{conceptText}}</p>"
                },
                "metadata": {
                  "title": "{{textTitle}}",
                  "license": "U"
                }
              }
            },
            {
              "x": 5,
              "y": 47,
              "width": 90,
              "height": 48,
              "action": {
                "library": "H5P.Blanks 1.14",
                "params": {
                  "text": "<p>{{blanksTask}}</p>",
                  "questions": ["<p>{{blanksSentence}} *{{blanksAnswer}}*</p>"],
                  "behaviour": {
                    "enableRetry": true,
                    "enableSolutionsButton": true,
                    "caseSensitive": false,
                    "acceptSpellingErrors": true
                  }
                },
                "metadata": {
                  "title": "{{checkTitle}}",
                  "license": "U"
                }
              }
            }
          ],
          "keywords": [
            {
              "main": "{{concept2Name}}"
            }
          ]
        },
        {
          "elements": [
            {
              "x": 5,
              "y": 5,
              "width": 90,
              "height": 40,
              "action": {
