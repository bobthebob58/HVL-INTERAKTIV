{
  "library": "H5P.Column 1.22",
  "metadataTitle": "{{title}}",
  "params": {
    "content": [
      {
        "content": {
          "library": "H5P.AdvancedText 1.1",
          "params": {
            "text": "<p>{{introText}}</p>"
          },
          "metadata": {
            "title": "{{introTitle}}",
            "license": "U"
          }
        }
      },
      {
        "content": {
          "library": "H5P.Blanks 1.14",
          "params": {
            "text": "<p>{{blanksTask}}</p>",
            "questions": ["<p>{{blanksSentence}} *{{blanksAnswer}}*</p>"],
            "behaviour": {
              "enableRetry": true,
              "enableSolutionsButton": true,
              "caseSensitive": false,
              "acceptSpellingErrors": true
            }
          },
          "metadata": {
            "title": "{{blanksTitle}}",
            "license": "U"
          }
        }
      },
      {
        "content": {
          "library": "H5P.MultiChoice 1.16",
          "params": {
            "question": "<p>{{mcQuestion}}</p>",
            "answers": [
              {
                "text": "<div>{{correctAnswer}}</div>",
                "correct": true,
                "tipsAndFeedback": {
                  "chosenFeedback": "<div>{{correctFeedback}}</div>"
                }
              },
              {
                "text": "<div>{{wrongAnswer1}}</div>",
                "correct": false,
                "tipsAndFeedback": {
                  "chosenFeedback": "<div>{{wrongFeedback}}</div>"
                }
              },
              {
                "text": "<div>{{wrongAnswer2}}</div>",
                "correct": false,
                "tipsAndFeedback": {
                  "chosenFeedback": "<div>{{wrongFeedback}}</div>"
                }
              }
            ],
            "behaviour": {
              "enableRetry": true,
              "enableSolutionsButton": true
            },
            "UI": {
              "submitAnswerButton": "{{submitButton}}",
              "readFeedback": "{{readFeedback}}",
              "correctAnswer": "{{correctAnswerLabel}}",
              "scoreBarLabel": "{{scoreBarLabel}}",
              "a11yCheck": "{{a11yCheck}}",
              "a11yShowSolution": "{{a11yShowSolution}}",
              "a11yRetry": "{{a11yRetry}}"
            },
            "confirmCheck": {
              "header": "{{confirmCheckHeader}}"
            }
          },
          "metadata": {
            "title": "{{mcTitle}}",
            "license": "U"
          }
        }
      }
    ]
  }
}
