{
  "library": "H5P.InteractiveVideo 1.28",
  "metadataTitle": "{{title}}",
  "params": {
    "interactiveVideo": {
      "video": {
        "startScreenOptions": {
          "title": "{{videoTitle}}",
          "shortStartDescription": "{{videoDescription}}"
        },
        "textTracks": {
          "videoTrack": [
            {
              "label": "{{captionsLabel}}",
              "kind": "captions",
              "srcLang": "{{captionsLanguage}}"
            }
          ]
        }
      },
      "assets": {
        "interactions": [
          {
            "x": 45,
            "y": 40,
            "width": 10,
            "height": 10,
            "duration": {
              "from": 150,
              "to": 160
            },
            "pause": true,
            "label": "{{interactionLabel}}",
            "action": {
              "library": "H5P.MultiChoice 1.16",
              "params": {
                "question": "<p>{{question1}}</p>",
                "answers": [
                  {
                    "text": "<div>{{correctAnswer}}</div>",
                    "correct": true,
                    "tipsAndFeedback": {
                      "chosenFeedback": "<div>{{correctFeedback}}</div>"
                    }
                  },
                  {
                    "text": "<div>{{wrongAnswer1}}</div>",
                    "correct": false,
                    "tipsAndFeedback": {
                      "chosenFeedback": "<div>{{wrongFeedback}}</div>"
                    }
                  },
                  {
                    "text": "<div>{{wrongAnswer2}}</div>",
                    "correct": false,
                    "tipsAndFeedback": {
                      "chosenFeedback": "<div>{{wrongFeedback}}</div>"
                    }
                  }
                ],
                "behaviour": {
                  "enableRetry": true,
                  "enableSolutionsButton": true
                },
                "UI": {
                  "submitAnswerButton": "{{submitButton}}",
                  "readFeedback": "{{readFeedback}}",
                  "correctAnswer": "{{correctAnswerLabel}}",
                  "scoreBarLabel": "{{scoreBarLabel}}",
                  "a11yCheck": "{{a11yCheck}}",
                  "a11yShowSolution": "{{a11yShowSolution}}",
                  "a11yRetry": "{{a11yRetry}}"
                },
                "confirmCheck": {
                  "header": "{{confirmCheckHeader}}"
                }
              },
              "metadata": {
                "title": "{{question1Title}}",
                "license": "U"
              }
            }
          },
          {
            "x": 45,
            "y": 40,
            "width": 10,
            "height": 10,
            "duration": {
              "from": 300,
              "to": 310
            },
            "pause": true,
            "label": "{{interactionLabel}}",
            "action": {
              "library": "H5P.Blanks 1.14",
              "params": {
                "text": "<p>{{blanksTask}}</p>",
                "questions": ["<p>{{blanksSentence}} *{{blanksAnswer}}*</p>"],
                "behaviour": {
                  "enableRetry": true,
                  "enableSolutionsButton": true,
                  "caseSensitive": false,
                  "acceptSpellingErrors": true
                }
              },
              "metadata": {
                "title": "{{question2Title}}",
                "license": "U"
              }
            }
          },
          {
            "x": 45,
            "y": 40,
            "width": 10,
            "height": 10,
            "duration": {
              "from": 450,
              "to": 460
            },
            "pause": true,
            "label": "{{interactionLabel}}",
            "action": {
              "library": "H5P.MultiChoice 1.16",
              "params": {
                "question": "<p>{{question3}}</p>",
                "answers": [
                  {
                    "text": "<div>{{correctAnswer}}</div>",
                    "correct": true,
                    "tipsAndFeedback": {
                      "chosenFeedback": "<div>{{correctFeedback}}</div>"
                    }
                  },
                  {
                    "text": "<div>{{wrongAnswer1}}</div>",
                    "correct": false,
                    "tipsAndFeedback": {
                      "chosenFeedback": "<div>{{wrongFeedback}}</div>"
                    }
                  },
                  {
                    "text": "<div>{{wrongAnswer2}}</div>",
                    "correct": false,
                    "tipsAndFeedback": {
                      "chosenFeedback": "<div>{{wrongFeedback}}</div>"
                    }
                  }
                ],
                "behaviour": {
                  "enableRetry": true,
                  "enableSolutionsButton": true
                },
                "UI": {
                  "submitAnswerButton": "{{submitButton}}",
                  "readFeedback": "{{readFeedback}}",
                  "correctAnswer": "{{correctAnswerLabel}}",
                  "scoreBarLabel": "{{scoreBarLabel}}",
                  "a11yCheck": "{{a11yCheck}}",
                  "a11yShowSolution": "{{a11yShowSolution}}",
                  "a11yRetry": "{{a11yRetry}}"
                },
                "confirmCheck": {
                  "header": "{{confirmCheckHeader}}"
                }
              },
              "metadata": {
                "title": "{{question3Title}}",
                "license": "U"
              }
            }
          }
        ],
        "bookmarks": [],
        "endscreens": []
      },
      "summary": {
        "task": {
          "library": "H5P.Summary 1.10",
          "params": {
            "intro": "<p>{{summaryIntro}}</p>",
            "summaries": [
              {
                "summary": ["<p>{{summaryTrue1}}</p>", "<p>{{summaryFalse1}}</p>"]
              },
              {
                "summary": ["<p>{{summaryTrue2}}</p>", "<p>{{summaryFalse2}}</p>"]
              },
              {
                "summary": ["<p>{{summaryTrue3}}</p>", "<p>{{summaryFalse3}}</p>"]
              }
            ],
            "labelIncorrect": "{{summaryIncorrect}}",
            "alternativeIncorrectLabel": "{{summaryIncorrectShort}}",
            "scoreBarLabel": "{{scoreBarLabel}}",
            "progressText": "{{summaryProgress}}"
          },
          "metadata": {
            "title": "{{summaryTitle}}",
            "license": "U"
          }
        },
        "displayAt": 3
      }
    },
    "override": {
      "showSolutionButton": "on",
      "retryButton": "on",
      "preventSkippingMode": "none"
    },
    "l10n": {
      "endcardQuestion": "{{endcardQuestion}}",
      "endCardTableRowSummaryWithScore": "{{endcardRowWithScore}}",
      "endCardTableRowSummaryWithoutScore": "{{endcardRowWithoutScore}}"
    }
  }
}
