# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Generated Prisma client (regenerated by `prisma generate`)
apps/server/src/generated/

# H5P core and editor client files: fetched and hash-verified by tools/h5p-core (D-027)
apps/server/h5p/core/
apps/server/h5p/editor/

# Browsable API docs, generated by `npm run docs:api` (TypeDoc)
docs/api/

# Local runtime data (H5P libraries, temp files in development)
apps/server/var/

# Environment files with real values; .env.example is committed
.env
.env.*
!.env.example

# Next.js build output and its generated type references (rewritten by `next build`, `next dev` and `next typegen`)
apps/web/.next/
apps/web/next-env.d.ts
