# npm settings for everyone who installs this project: developers, CI and the image build (deploy/Dockerfile).
# SECURITY: a dependency's install script runs only when the root package.json names it in `allowScripts`. Without
# this line npm 11 runs a script outside the list and only prints a notice; with it, the install stops
# (SEC-007, D-145). `npm run check:lockfile` holds the list and this line.
strict-allow-scripts=true
